# /etc/hiworks-sync.env  (권한 600)
HIWORKS_ID=api@yourcompany.com
HIWORKS_PW=여기에_전용계정_비밀번호
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=hiworks_sync
MYSQL_PASSWORD=여기에_MySQL_비밀번호
MYSQL_DB=asterisk
# HTTP CID 조회의 DB 연결/읽기/쓰기 및 공유 연결 대기 제한(초, 양수, 기본 각 1초).
# 연결 오류는 1회 재시도한다. Asterisk CURL 제한은 재시도와 락 대기까지 고려한다.
# MYSQL_CONNECT_TIMEOUT=1
# MYSQL_READ_TIMEOUT=1
# MYSQL_WRITE_TIMEOUT=1
# DB_LOCK_TIMEOUT=1
COOKIE_FILE=/opt/hiworks/cookies.json
COOKIE_MAX_AGE=43200
# 연락처 상세의 휴대폰/회사전화/팩스/기타 번호 캐시(권한 600, 변경 연락처만 재조회).
CONTACT_DETAIL_CACHE_FILE=/opt/hiworks/contact_details.json
# CONTACT_DETAIL_CACHE_MAX_AGE=86400  # updated_at이 같아도 하루마다 전체 상세 새로 확인
# CONTACT_DETAIL_WORKERS=6            # 최초/전체 갱신 시 상세 API 동시 요청 수
PORT=8088
# 조직도(직원) 동기화 — Open API Bearer 토큰. 미설정이면 공유주소록만 동기화.
# 직원은 '이름 (부서)' 형식으로 CID 표시됨.
# HIWORKS_OFFICE_TOKEN=
# HIWORKS_ORG_API_URL=https://api.hiworks.com/hrm/v2/organizations
# 동기화 연속 실패 알림(n8n 웹훅). 미설정이면 알림 비활성.
# ALERT_WEBHOOK_URL=https://n8n.example.com/webhook/hiworks-sync
# ALERT_AFTER_FAILURES=3      # 연속 N회 실패부터 알림 (2분 주기면 ~6분)
# ALERT_REPEAT_EVERY=30       # 이후 N회마다 재알림 (스팸 방지, ~1시간)
# Uptime Kuma 연동 (권장): 동기화 성공마다 push URL 호출 → 끊기면 Kuma가 텔레그램 알림.
# Kuma 쪽에는 HTTP 모니터로 http://10.0.5.209:8088/health 도 등록 (비정상=503).
# HEARTBEAT_URL=http://<kuma-host>:3001/api/push/<token>?status=up&msg=OK
# HEALTH_MAX_FAILURES=3       # /health: 연속실패 N회부터 503
# HEALTH_MAX_AGE=600          # /health: 마지막 동기화 성공 후 N초 넘으면 503
# 수동 쿠키로 먼저 검증하려면 아래 주석을 풀고 브라우저 cookie 값을 붙여넣으세요
# HIWORKS_COOKIE=
